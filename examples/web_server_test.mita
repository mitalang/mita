(sada ((test_handler (muhe (req)
  (zido ((path (lawakucha req)))
    (dala ((shato path "/") (http_ok "Hello from MITA"))
      (da (http_not_found "404"))))))))

(zido ((fd (net_listen 18080)))
  (dala ((aba fd 0) nye)
    (da (in
      (beru (tiga "fd" fd))
      (handle_connection fd test_handler)
      (net_close fd)
      da))))
