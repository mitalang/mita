; 变量赋值示例 (plama)
; plama = setq, 修改变量值

; 基本赋值
(zido ((x 0))
  (movo x unu)
  x)  ; => 1

; 多次赋值
(zido ((x 0))
  (in
    (movo x (celi x unu))
    (movo x (celi x du))
    x))  ; => 3

; 交换两个变量
(zido ((a unu) (b du))
  (zido ((tmp a))
    (in
      (movo a b)
      (movo b tmp)
      (upa a b))))  ; => (2 . 1)
