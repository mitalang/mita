; 高阶函数示例
; 需要先加载 odomu.mita
; 展示 si (map), valo (filter), mosi (reduce)

; map: 平方列表
(si (muhe (x) (kuzi x x)) (tiga unu du unudu))

; filter: 筛选大于 2 的数
(valo (muhe (x) (unta x du)) (tiga unu du unudu dudu mani))

; reduce: 求和
(mosi (muhe (a b) (celi a b)) 0 (tiga unu du unudu))

; reduce: 求积
(mosi (muhe (a b) (kuzi a b)) unu (tiga unu du unudu))

; 组合使用
; 先 map 平方，再 filter 大于 3 的，再求和
(mosi (muhe (a b) (celi a b))
      0
      (valo (muhe (x) (unta x du))
            (si (muhe (x) (kuzi x x))
                (tiga unu du unudu dudu))))
