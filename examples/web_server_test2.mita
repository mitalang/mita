(sada (
  (test_handler (muhe (req)
    (zido ((path (lawakucha req)))
      (dala ((shato path "/") "Hello from MITA")
        (da "404")))))

  (handle_client (muhe (client)
    (in
      (zido ((raw (net_read client)))
        (in
          (beru (tiga "raw" raw))
          (net_write client
            (http_ok
              (test_handler (sys_http_parse_request raw))))))
      (net_close client)
      da)))

  (serve_one (muhe (fd)
    (in
      (beru (tiga "fd" fd))
      (zido ((client (net_accept fd)))
        (in
          (beru (tiga "client" client))
          (handle_client client)))
      (net_close fd)
      da)))))

(zido ((fd (net_listen 18080)))
  (serve_one fd))
