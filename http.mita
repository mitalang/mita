; http.mita — MITA HTTP Server Library (minimal)

(sada (
  (http_ok (muhe (body)
    (sys_http_response 200 body "text/html; charset=utf-8")))

  (http_not_found (muhe (body)
    (sys_http_response 404 body "text/html; charset=utf-8")))

  (url_decode (muhe (s) (sys_url_decode s)))

  (handle_connection (muhe (listen_fd handler)
    (zido ((client_fd (sys_accept listen_fd)))
      (dala ((aba client_fd 0) nye)
        (da (in
          (zido ((raw (sys_read_http client_fd)))
            (zido ((parsed (sys_http_parse_request raw)))
              (in
                (beru (sys_string_concat (tiga (lawa parsed) " " (lawakucha parsed))))
                (sys_write client_fd (handler parsed)))))
          (sys_close client_fd)
          da))))))

  (serve_loop (muhe (listen_fd handler)
    (in
      (handle_connection listen_fd handler)
      (serve_loop listen_fd handler))))

  (run_server (muhe (host port handler)
    (zido ((fd (sys_listen port host)))
      (dala ((aba fd 0) nye)
        (da (in
          (beru (sys_string_concat (tiga "Server listening on " host ":" port)))
          (serve_loop fd handler)
          nye))
        (da (in
          (beru (sys_string_concat (tiga "Failed to bind " host ":" port)))
          nye))))))
))
